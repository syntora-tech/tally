{
  "name": "tally",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @tally/web dev",
    "build": "pnpm --filter @tally/web build",
    "lint": "pnpm --filter @tally/web typegen && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @tally/web e2e",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "sb": "./scripts/supabase.sh",
    "db:start": "./scripts/supabase.sh start",
    "db:stop": "./scripts/supabase.sh stop",
    "db:reset": "./scripts/supabase.sh db reset",
    "db:test": "./scripts/supabase.sh test db",
    "db:generate": "pnpm --filter @tally/db generate",
    "db:migration": "pnpm --filter @tally/db migration",
    "test:int": "pnpm -r --workspace-concurrency=1 --if-present test:int",
    "env:local": "node scripts/setup-env.mjs",
    "e2e:install": "pnpm --filter @tally/web e2e:install",
    "import:legacy": "pnpm --filter @tally/import-legacy start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0"
  }
}
