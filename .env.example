# Copy to apps/web/.env.local for local development.
# Local values below come from `pnpm supabase status` after `pnpm db:start`.

# --- Database -------------------------------------------------------------
# Runtime connection. Production: Supabase pooler (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct connection for migrations and pg_dump backups (not the pooler).
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase Auth --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable/anon key from `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated whitelist for first sign-in (later access is governed by app_user).
ALLOWED_EMAILS=owner@example.com

# Google OAuth (optional). Leave empty to keep the provider disabled.
# Read by supabase/config.toml via env(); the redirect URI in Google Console
# must be http://127.0.0.1:54321/auth/v1/callback locally.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
# Shows the "Sign in with Google" button when set to true.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Google Drive / Docs (stage 1+) ---------------------------------------
GOOGLE_SA_EMAIL=
# PEM with literal \n line breaks.
GOOGLE_SA_PRIVATE_KEY=
# Environment root folder: Shared Drive root, or the _dev / _preview folder.
GOOGLE_DRIVE_ROOT_ID=
# drive | local
STORAGE_DRIVER=local

# --- Background jobs -------------------------------------------------------
# Shared secret pg_cron sends to /api/cron/<name>.
CRON_SECRET=change-me-local-cron-secret

# --- Testing ---------------------------------------------------------------
# Fake "today" (YYYY-MM-DD) for deadline scenarios. Ignored when VERCEL_ENV=production.
APP_TODAY=

# --- Backups (GitHub Actions secret, not used by the app) ------------------
BACKUP_AGE_PUBLIC_KEY=
